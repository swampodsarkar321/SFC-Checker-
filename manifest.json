{
  "manifest_version": 3,
  "name": "SFC TICKET CHECKER",
  "version": "3.0.4",
  "description": "SFC TICKET CHECKER — Packzy customer reply tracking and response-time alerts by MD SWAMPOD SARKAR.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://dash.packzy.com/*",
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dash.packzy.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "SFC TICKET CHECKER"
  },
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "dashboard.css", "dashboard.js"],
      "matches": ["<all_urls>"]
    }
  ]
}